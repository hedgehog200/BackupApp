{
  "app": {
    "language": "ru",
    "theme": "dark",
    "startWithWindows": true,
    "minimizeToTray": true,
    "hotkey": "Ctrl+Shift+B"
  },
  "sources": [],
  "schedules": [],
  "targets": [],
  "localStorage": {
    "enabled": true,
    "path": "C:\\Backups\\Local",
    "retention": {
      "keepLastN": 5,
      "keepDays": 30
    }
  },
  "notifications": {
    "toast": true,
    "email": {
      "enabled": false,
      "smtpHost": "",
      "smtpPort": 587,
      "username": "",
      "passwordKey": "",
      "useSsl": true
    }
  },
  "network": {
    "timeoutSeconds": 30,
    "maxParallelTransfers": 3,
    "retryCount": 3,
    "retryDelayMs": 5000
  }
}
